Subject: Omit private closures owned by unsupported Promise combinators

Keep builtin IDs, shared-function roots and descriptors intact.

--- a/v8/src/builtins/moonrun-omitted-builtins.h
+++ b/v8/src/builtins/moonrun-omitted-builtins.h
@@ -157,6 +157,15 @@
   V(JsonParse, JSON, "parse") \
