+// Private closures owned only by the omitted all/allSettled/any combinators.
+// Keep their shared-function roots and builtin identities for heap metadata and
+// async stack inspection; no retained operation creates these closures.
+#define MOONRUN_OMITTED_PROMISE_CLOSURES(V) \
+  V(PromiseAllResolveElementClosure, promise_all_resolve_element_closure) \
+  V(PromiseAllSettledResolveElementClosure, promise_all_settled_resolve_element_closure) \
+  V(PromiseAllSettledRejectElementClosure, promise_all_settled_reject_element_closure) \
+  V(PromiseAnyRejectElementClosure, promise_any_reject_element_closure)
+
 #define MOONRUN_OMITTED_JS_BUILTINS(V) \
   MOONRUN_OMITTED_TFJ_BUILTINS(V) \
   MOONRUN_OMITTED_CPP_BUILTINS(V)
--- a/v8/src/builtins/setup-builtins-internal.cc
