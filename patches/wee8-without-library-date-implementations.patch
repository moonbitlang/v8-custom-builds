Subject: Exclude already-unsupported Date method implementations in custom wee8

Requires the generated builtin-body profile. Ordinary V8 retains full Date
implementations; the new define is scoped to the Date source target.

--- a/v8/BUILD.gn
+++ b/v8/BUILD.gn
@@ -36,6 +36,9 @@
 
   # Keep asm.js translation optional independently of binary Wasm support.
   v8_enable_asmjs = true
+
+  # Keep Date construction/coercion while optionally omitting disabled methods.
+  v8_wee8_omit_date_method_implementations = v8_custom_wee8
 
   # Disable JavaScript source parsing for native Wasm embedders.
   v8_enable_javascript_parser = true
@@ -5406,6 +5409,27 @@
   }
 }
 
+# Scope Date implementation selection to its own compilation units.
+# Runtime layouts, builtin IDs and external-reference table slots stay intact.
+assert(!v8_wee8_omit_date_method_implementations ||
+           (v8_custom_wee8 && v8_moonrun_omit_library_builtin_bodies),
+       "Date implementation trimming requires the custom builtin-body profile")
+v8_source_set("v8_date_builtins") {
+  sources = [ "src/builtins/builtins-date.cc" ]
+  configs = [ ":internal_config", ":cppgc_base_config" ]
+  deps = [
+    ":v8_abseil",
+    ":v8_internal_headers",
+    ":v8_shared_internal_headers",
+    ":v8_maybe_icu",
+    ":v8_tracing",
+  ]
+  if (v8_wee8_omit_date_method_implementations) {
+    defines = [ "V8_WEE8_TRIM_DATE_IMPLEMENTATIONS" ]
+    sources += [ "src/builtins/builtins-date-disabled.cc" ]
+  }
+}
+
 v8_source_set("v8_base_without_compiler") {
   # Only targets in this file and gcmole can depend on this.
   visibility = [
@@ -5444,7 +5468,6 @@
     "src/builtins/builtins-collections.cc",
     "src/builtins/builtins-console.cc",
     "src/builtins/builtins-dataview.cc",
-    "src/builtins/builtins-date.cc",
     "src/builtins/builtins-disposable-stack.cc",
     "src/builtins/builtins-error.cc",
     "src/builtins/builtins-function.cc",
@@ -6352,6 +6375,7 @@
   ]
 
   deps = [
+    ":v8_date_builtins",
     ":torque_generated_definitions",
     ":v8_bigint",
     ":v8_headers",
