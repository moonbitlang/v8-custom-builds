+// Keep the existing CPP metadata and external-reference slots. The generated
+// JS entry bodies already trap; these distinct stubs also reject a direct CPP
+// entry without retaining the unused calendar and formatting implementations.
+#define UNSUPPORTED_DATE(Name, Receiver, Method) \
+  BUILTIN(Name) { UNREACHABLE(); }
+MOONRUN_OMITTED_DATE_CPP_BUILTINS(UNSUPPORTED_DATE)
+#undef UNSUPPORTED_DATE
+
+}  // namespace internal
+}  // namespace v8
