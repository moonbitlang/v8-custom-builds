+// Tag Instances and catchable exceptions
+
+template <>
+struct implement<Tag> {
+  using type = RefImpl<Tag, i::WasmTagObject>;
+};
+
+Tag::~Tag() = default;
+auto Tag::copy() const -> own<Tag> { return impl(this)->copy(); }
+auto Tag::same(const Tag* other) const -> bool {
+  if (impl(this)->store() != impl(other)->store()) return false;
+  PtrComprCageAccessScope scope(impl(this)->isolate());
+  return impl(this)->v8_object()->tag() == impl(other)->v8_object()->tag();
+}
+
+auto Tag::make(Store* store_abs, const TagType* type) -> own<Tag> {
+  StoreImpl* store = impl(store_abs);
+  i::Isolate* isolate = store->i_isolate();
+  v8::Isolate::Scope isolate_scope(reinterpret_cast<v8::Isolate*>(isolate));
+  i::HandleScope handle_scope(isolate);
+  CheckAndHandleInterrupts(isolate);
+  const auto& params = type->functype()->params();
+  std::vector<i::wasm::ValueType> types;
+  for (size_t n = 0; n < params.size(); ++n) {
+    types.push_back(WasmValKindToV8(params[n]->kind()));
+  }
+  i::wasm::FunctionSig sig(0, types.size(), types.data());
+  uint32_t canonical_index =
+      i::wasm::GetWasmEngine()->type_canonicalizer()->AddRecursiveGroup(&sig);
+  auto identity = i::WasmExceptionTag::New(isolate, 0);
+  auto object = i::WasmTagObject::New(isolate, &sig, canonical_index, identity,
+                                      i::Handle<i::WasmTrustedInstanceData>());
+  return implement<Tag>::type::make(store, object);
+}
+
+auto Tag::type() const -> own<TagType> {
+  i::Isolate* isolate = impl(this)->isolate();
+  v8::Isolate::Scope isolate_scope(reinterpret_cast<v8::Isolate*>(isolate));
+  i::HandleScope handle_scope(isolate);
+  auto signature = impl(this)->v8_object()->serialized_signature();
+  ownvec<ValType> params =
+      ownvec<ValType>::make_uninitialized(signature->length());
+  for (int n = 0; n < signature->length(); ++n) {
+    params[n] = ValType::make(V8ValueTypeToWasm(signature->get(n)));
+  }
+  return TagType::make(FuncType::make(std::move(params)));
+}
+
+// Unlike Trap::make, these objects do not have wasm_uncatchable_symbol. The
+// existing host-callback trampoline throws their native identity unchanged.
+auto MakeException(Store* store_abs, const Tag* tag,
+                   const vec<Val>& args) -> own<Trap> {
+  StoreImpl* store = impl(store_abs);
+  if (impl(tag)->store() != store) return nullptr;
+  i::Isolate* isolate = store->i_isolate();
+  v8::Isolate::Scope isolate_scope(reinterpret_cast<v8::Isolate*>(isolate));
+  i::HandleScope handle_scope(isolate);
+  CheckAndHandleInterrupts(isolate);
+  auto object = impl(tag)->v8_object();
+  i::Handle<i::PodArray<i::wasm::ValueType>> signature(
+      object->serialized_signature(), isolate);
+  if (args.size() != static_cast<size_t>(signature->length())) return nullptr;
+  for (size_t n = 0; n < args.size(); ++n) {
+    auto type = signature->get(static_cast<int>(n));
+    if (type != i::wasm::kWasmI32 && type != i::wasm::kWasmI64 &&
+        type != i::wasm::kWasmF32 && type != i::wasm::kWasmF64 &&
+        type != i::wasm::kWasmExternRef)
+      return nullptr;
+    if (args[n].kind() != V8ValueTypeToWasm(type)) return nullptr;
+    if (args[n].kind() == ANYREF && args[n].ref() &&
+        impl(args[n].ref())->store() != store)
+      return nullptr;
+  }
+  i::wasm::WasmTagSig sig(
+      0, signature->length(),
+      reinterpret_cast<i::wasm::ValueType*>(signature->begin()));
+  auto exception = i::WasmExceptionPackage::New(
+      isolate, i::handle(i::Cast<i::WasmExceptionTag>(object->tag()), isolate),
+      i::WasmExceptionPackage::GetEncodedSize(&sig));
+  auto values = i::Cast<i::FixedArray>(
+      i::WasmExceptionPackage::GetExceptionValues(isolate, exception));
+  uint32_t index = 0;
+  for (size_t n = 0; n < args.size(); ++n) {
+    const auto& arg = args[n];
+    switch (arg.kind()) {
+      case I32:
+        i::EncodeI32ExceptionValue(values, &index, arg.i32());
+        break;
+      case I64:
+        i::EncodeI64ExceptionValue(values, &index, arg.i64());
+        break;
+      case F32:
+        i::EncodeI32ExceptionValue(values, &index,
+                                   v8::base::bit_cast<int32_t>(arg.f32()));
+        break;
+      case F64:
+        i::EncodeI64ExceptionValue(values, &index,
+                                   v8::base::bit_cast<int64_t>(arg.f64()));
+        break;
+      case ANYREF:
+        values->set(index++, *WasmRefToV8(isolate, arg.ref()));
+        break;
+      default:
+        UNREACHABLE();
+    }
+  }
+  return implement<Trap>::type::make(store, exception);
+}
+
+bool IsException(const Trap* trap) {
+  PtrComprCageAccessScope scope(impl(trap)->isolate());
+  return i::IsWasmExceptionPackage(*impl(trap)->v8_object());
+}
+
+bool ExceptionIs(const Trap* trap, const Tag* tag) {
+  if (impl(trap)->store() != impl(tag)->store()) return false;
+  i::Isolate* isolate = impl(trap)->isolate();
+  v8::Isolate::Scope isolate_scope(reinterpret_cast<v8::Isolate*>(isolate));
+  i::HandleScope handle_scope(isolate);
+  if (!IsException(trap)) return false;
+  auto identity = i::WasmExceptionPackage::GetExceptionTag(
+      isolate, i::Cast<i::WasmExceptionPackage>(impl(trap)->v8_object()));
+  return *identity == impl(tag)->v8_object()->tag();
+}
+
+auto ExceptionArgs(const Trap* trap, const Tag* tag) -> vec<Val> {
+  if (!ExceptionIs(trap, tag)) return vec<Val>::invalid();
+  StoreImpl* store = impl(trap)->store();
+  i::Isolate* isolate = store->i_isolate();
+  v8::Isolate::Scope isolate_scope(reinterpret_cast<v8::Isolate*>(isolate));
+  i::HandleScope handle_scope(isolate);
+  i::Handle<i::PodArray<i::wasm::ValueType>> signature(
+      impl(tag)->v8_object()->serialized_signature(), isolate);
+  auto values =
+      i::Cast<i::FixedArray>(i::WasmExceptionPackage::GetExceptionValues(
+          isolate, i::Cast<i::WasmExceptionPackage>(impl(trap)->v8_object())));
+  auto args = vec<Val>::make_uninitialized(signature->length());
+  uint32_t index = 0;
+  for (size_t n = 0; n < args.size(); ++n) {
+    auto type = signature->get(static_cast<int>(n));
+    if (type == i::wasm::kWasmI32 || type == i::wasm::kWasmF32) {
+      uint32_t bits;
+      i::DecodeI32ExceptionValue(values, &index, &bits);
+      args[n] = type == i::wasm::kWasmI32
+                    ? Val(static_cast<int32_t>(bits))
+                    : Val(v8::base::bit_cast<float>(bits));
+    } else if (type == i::wasm::kWasmI64 || type == i::wasm::kWasmF64) {
+      uint64_t bits;
+      i::DecodeI64ExceptionValue(values, &index, &bits);
+      args[n] = type == i::wasm::kWasmI64
+                    ? Val(static_cast<int64_t>(bits))
+                    : Val(v8::base::bit_cast<double>(bits));
+    } else if (type == i::wasm::kWasmExternRef) {
+      i::Handle<i::Object> value(values->get(index++), isolate);
+      if (!i::IsNull(*value, isolate) && !i::IsJSReceiver(*value)) {
+        return vec<Val>::invalid();
+      }
+      args[n] = Val(V8RefValueToWasm(store, value));
+    } else {
+      return vec<Val>::invalid();
+    }
+  }
+  return args;
+}
