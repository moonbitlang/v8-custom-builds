   return memory->grow(delta);
 }
 
+// Per-store native stack boundary (wee8 extension).
+uintptr_t wee8_store_set_stack_limit(wasm_store_t* store, uintptr_t limit) {
+  if (limit == 0) return 0;
+  auto* impl = wasm::impl(reveal_store(store));
+  v8::Isolate::Scope scope(impl->isolate());
+  uintptr_t previous = impl->i_isolate()->stack_guard()->real_climit();
+  impl->isolate()->SetStackLimit(limit);
+  return previous;
+}
