Subject: Make asm.js an optional build capability

Base: rusty_v8 v0.106.0, V8 12.9.202.13.

Keep the upstream translator intact and enabled by default. The custom
profile excludes it; guard direct callers instead of depending on dead stripping.
Retain shared Wasm metadata and runtime IDs for generated code and snapshots.

--- a/v8/BUILD.gn
+++ b/v8/BUILD.gn
@@ -27,6 +27,9 @@
 
 declare_args() {
   v8_custom_wee8 = false
+
+  # Keep asm.js translation optional independently of binary Wasm support.
+  v8_enable_asmjs = true
 
   # Disable JavaScript source parsing for native Wasm embedders.
   v8_enable_javascript_parser = true
@@ -1089,6 +1092,12 @@
 
   if (v8_custom_wee8) {
     defines += [ "V8_CUSTOM_WEE8" ]
+  }
+
+  if (v8_enable_asmjs) {
+    defines += [ "V8_ENABLE_ASMJS=1" ]
+  } else {
+    defines += [ "V8_ENABLE_ASMJS=0" ]
   }
 
   if (v8_enable_javascript_parser) {
@@ -5998,6 +6007,16 @@
       "src/wasm/well-known-imports.cc",
       "src/wasm/wrappers.cc",
     ]
+    if (!v8_enable_asmjs) {
+      # Preserve the upstream source list and shared Wasm export metadata.
+      sources -= [
+        "src/asmjs/asm-js.cc",
+        "src/asmjs/asm-parser.cc",
+        "src/asmjs/asm-scanner.cc",
+        "src/asmjs/asm-types.cc",
+      ]
+      sources += [ "src/asmjs/asm-js-disabled.cc" ]
+    }
     if (!is_official_build) {
       sources += [
         ### gcmole(all) ###
