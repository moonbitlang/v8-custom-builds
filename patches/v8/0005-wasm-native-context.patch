--- a/src/builtins/setup-builtins-internal.cc
+++ b/src/builtins/setup-builtins-internal.cc
@@ -6,6 +6,9 @@
 
 #include "src/builtins/builtins-inl.h"
 #include "src/builtins/profile-data-reader.h"
+
+#include "custom_wee8/src/cpp-builtin-selection.h"
+#include "custom_wee8/src/generated-js-builtin-selection.h"
 #include "src/codegen/assembler-inl.h"
 #include "src/codegen/interface-descriptors.h"
 #include "src/codegen/macro-assembler-inl.h"
@@ -177,7 +180,8 @@ V8_NOINLINE Tagged<Code> BuildWithMacroAssembler(
 }
 
 Tagged<Code> BuildAdaptor(Isolate* isolate, Builtin builtin,
-                          Address builtin_address, const char* name) {
+                          Address builtin_address, const char* name,
+                          bool omit_body) {
   HandleScope scope(isolate);
   uint8_t buffer[kBufferSize];
   MacroAssembler masm(isolate, BuiltinAssemblerOptions(isolate, builtin),
@@ -185,7 +189,15 @@ Tagged<Code> BuildAdaptor(Isolate* isolate, Builtin builtin,
                       ExternalAssemblerBuffer(buffer, kBufferSize));
   masm.set_builtin(builtin);
   DCHECK(!masm.has_frame());
-  Builtins::Generate_Adaptor(&masm, builtin_address);
+  // Preserve the CPP builtin builder and metadata; only its entry body changes.
+  // Native entry selection is handled separately by the CPP tables.
+  if (omit_body) {
+    // Retain the architecture-specific landing pad emitted by the adaptor.
+    masm.CodeEntry();
+    masm.DebugBreak();
+  } else {
+    Builtins::Generate_Adaptor(&masm, builtin_address);
+  }
   CodeDesc desc;
   masm.GetCode(isolate, &desc);
   DirectHandle<Code> code =
@@ -405,11 +417,33 @@ void SetupIsolateDelegate::SetupBuiltinsInternal(Isolate* isolate) {
   // Create a scope for the handles in the builtins.
   HandleScope scope(isolate);
 
+  // One positive selection per entry kind; preserve the original builders,
+  // descriptors and Code identities for both retained and unsupported entries.
+  const auto select_js_body = [](Builtin builtin,
+                                 CodeAssemblerGenerator original) {
+#if defined(V8_CUSTOM_WEE8)
+    if (!WasmContextKeepsJsBuiltin(builtin)) {
+      return +[](compiler::CodeAssemblerState* state) {
+        compiler::CodeAssembler(state).Unreachable();
+      };
+    }
+#endif
+    return original;
+  };
+  const auto omit_cpp_body = [](Builtin builtin) {
+#if defined(V8_CUSTOM_WEE8)
+    return !WasmContextKeepsCppBuiltin(builtin);
+#else
+    return false;
+#endif
+  };
+
   int index = 0;
   Tagged<Code> code;
 #define BUILD_CPP(Name)                                      \
   code = BuildAdaptor(isolate, Builtin::k##Name,             \
-                      FUNCTION_ADDR(Builtin_##Name), #Name); \
+                      WASM_CONTEXT_CPP_ENTRY(Name), #Name, \
+                      omit_cpp_body(Builtin::k##Name)); \
   AddBuiltin(builtins, Builtin::k##Name, code);              \
   index++;
 
@@ -421,7 +455,9 @@ void SetupIsolateDelegate::SetupBuiltinsInternal(Isolate* isolate) {
 
 #define BUILD_TFJ(Name, Argc, ...)                                         \
   code = BuildWithCodeStubAssemblerJS(                                     \
-      isolate, Builtin::k##Name, &Builtins::Generate_##Name, Argc, #Name); \
+      isolate, Builtin::k##Name,                                          \
+      select_js_body(Builtin::k##Name, &Builtins::Generate_##Name), Argc,   \
+      #Name);                                                            \
   AddBuiltin(builtins, Builtin::k##Name, code);                            \
   index++;
 
