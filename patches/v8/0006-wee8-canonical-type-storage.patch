-  zone_->freed_size_for_tracing_ = freed_size_for_tracing_;
+  zone->allocation_size_for_tracing_ = allocation_size_for_tracing_;
+  zone->freed_size_for_tracing_ = freed_size_for_tracing_;
 #endif
