diff --git a/src/parsing/parsing-disabled.cc b/src/parsing/parsing-disabled.cc
new file mode 100644
index 0000000000000000000000000000000000000000..574a7351f37e9e6c211c8ef47f3ef0fb0efd4443
--- /dev/null
+++ b/src/parsing/parsing-disabled.cc
@@ -0,0 +1,42 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/parsing/parsing.h"
+
+#include "src/parsing/parse-info.h"
+#include "src/parsing/pending-compilation-error-handler.h"
+
+namespace v8::internal::parsing {
+
+// Compilation and debugger clients use the same pending-error contract.
+// Reporting an error here prevents failed parsing from looking like stack
+// exhaustion to the compiler; no source is inspected or accepted.
+bool ParseProgram(ParseInfo* info, DirectHandle<Script> script,
+                  MaybeHandle<ScopeInfo> maybe_outer_scope_info,
+                  Isolate* isolate, ReportStatisticsMode mode) {
+  info->pending_error_handler()->ReportMessageAt(
+      0, 0, MessageTemplate::kJavaScriptParserDisabled);
+  return false;
+}
+
+bool ParseProgram(ParseInfo* info, DirectHandle<Script> script,
+                  Isolate* isolate, ReportStatisticsMode mode) {
+  return ParseProgram(info, script, kNullMaybeHandle, isolate, mode);
+}
+
+bool ParseFunction(ParseInfo* info, Handle<SharedFunctionInfo> shared_info,
+                   Isolate* isolate, ReportStatisticsMode mode) {
+  info->pending_error_handler()->ReportMessageAt(
+      0, 0, MessageTemplate::kJavaScriptParserDisabled);
+  return false;
+}
+
+bool ParseAny(ParseInfo* info, Handle<SharedFunctionInfo> shared_info,
+              Isolate* isolate, ReportStatisticsMode mode) {
+  info->pending_error_handler()->ReportMessageAt(
+      0, 0, MessageTemplate::kJavaScriptParserDisabled);
+  return false;
+}
+
+}  // namespace v8::internal::parsing
