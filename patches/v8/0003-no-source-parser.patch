From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wee8 maintenance <noreply@moonbitlang.com>
Date: Mon, 26 Oct 2026 10:18:18 +0800
Subject: Make JavaScript source parsing an optional build capability

Upstream-Status: Local runtime capability policy
Maintenance: Review compiler entry points and shared AST metadata when upgrading V8.
Tests: Script/module/function/streaming rejection and native context contracts.

The custom profile excludes JavaScript parser/scanner sources and returns
explicit compilation errors, including from background compilation. Shared
AST metadata, Wasm compilation and builtin/context machinery remain.
The upstream parser stays enabled by default.

diff --git a/BUILD.gn b/BUILD.gn
index 50512084c30703c1bf416612d5f5cad02892cdfd..bcf1cd33c011dbdbccebade474dcd28129ef43be 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -26,6 +26,9 @@ target_is_simulator = (target_cpu != v8_target_cpu && !v8_multi_arch_build) ||
 emit_builtins_as_inline_asm = is_win && is_clang
 
 declare_args() {
+  # Disable JavaScript source parsing for native Wasm embedders.
+  v8_enable_javascript_parser = true
+
   # The Wasm-only producer disables the JavaScript RegExp library.
   v8_enable_regexp = true
 
@@ -1082,6 +1085,11 @@ config("features") {
   defines =
       [ "V8_TYPED_ARRAY_MAX_SIZE_IN_HEAP=${v8_typed_array_max_size_in_heap}" ]
 
+  if (v8_enable_javascript_parser) {
+    defines += [ "V8_ENABLE_JAVASCRIPT_PARSER=1" ]
+  } else {
+    defines += [ "V8_ENABLE_JAVASCRIPT_PARSER=0" ]
+  }
   if (v8_enable_regexp) {
     defines += [ "V8_ENABLE_REGEXP=1" ]
   } else {
@@ -5358,6 +5366,20 @@ group("v8_tracing") {
   }
 }
 
+# The disabled capability reports a real compilation error through the same
+# interface. It does not link the JavaScript parser or silently accept source.
+if (!v8_enable_javascript_parser) {
+  v8_source_set("v8_javascript_parser_disabled") {
+    sources = [ "src/parsing/parsing-disabled.cc" ]
+    configs = [ ":internal_config" ]
+    deps = [
+      ":v8_abseil",
+      ":v8_internal_headers",
+      ":v8_shared_internal_headers",
+    ]
+  }
+}
+
 v8_source_set("v8_base_without_compiler") {
   # Only targets in this file and gcmole can depend on this.
   visibility = [
@@ -5898,6 +5920,20 @@ v8_source_set("v8_base_without_compiler") {
     ]
   }
 
+  if (!v8_enable_javascript_parser) {
+    # Keep the upstream implementation intact for parser-enabled builds.
+    sources -= [
+      "src/parsing/func-name-inferrer.cc",
+      "src/parsing/literal-buffer.cc",
+      "src/parsing/parser.cc",
+      "src/parsing/parsing.cc",
+      "src/parsing/preparser.cc",
+      "src/parsing/rewriter.cc",
+      "src/parsing/scanner-character-streams.cc",
+      "src/parsing/scanner.cc",
+    ]
+  }
+
   if (v8_enable_webassembly) {
     sources += [
       ### gcmole(all) ###
@@ -6291,6 +6327,10 @@ v8_source_set("v8_base_without_compiler") {
     "src/inspector:inspector",
   ]
 
+  if (!v8_enable_javascript_parser) {
+    deps += [ ":v8_javascript_parser_disabled" ]
+  }
+
   public_deps = [
     ":cppgc_base",
     ":generate_bytecode_builtins_list",
diff --git a/src/codegen/compiler.cc b/src/codegen/compiler.cc
index a6407a56aa8d6d73ec0bdcf94fa4bbd4e2c1cbb4..738fde5ab2f3621f905c6d68cd3fa140725b5799 100644
--- a/src/codegen/compiler.cc
+++ b/src/codegen/compiler.cc
@@ -57,7 +57,9 @@
 #include "src/objects/shared-function-info.h"
 #include "src/objects/string.h"
 #include "src/parsing/parse-info.h"
+#if V8_ENABLE_JAVASCRIPT_PARSER
 #include "src/parsing/parser.h"
+#endif
 #include "src/parsing/parsing.h"
 #include "src/parsing/pending-compilation-error-handler.h"
 #include "src/parsing/scanner-character-streams.h"
@@ -1652,8 +1654,10 @@ BackgroundCompileTask::BackgroundCompileTask(
           REPLMode::kNo, type,
           (options & ScriptCompiler::CompileOptions::kEagerCompile) == 0 &&
               v8_flags.lazy_streaming)),
+#if V8_ENABLE_JAVASCRIPT_PARSER
       character_stream_(ScannerStream::For(streamed_data->source_stream.get(),
                                            streamed_data->encoding)),
+#endif
       stack_size_(v8_flags.stack_size),
       worker_thread_runtime_call_stats_(
           isolate->counters()->worker_thread_runtime_call_stats()),
@@ -1940,6 +1944,8 @@ void BackgroundCompileTask::Run(
     }
   }
 
+  // A disabled parser never constructs or reads a source character stream.
+#if V8_ENABLE_JAVASCRIPT_PARSER
   // Update the character stream's runtime call stats.
   info.character_stream()->set_runtime_call_stats(info.runtime_call_stats());
 
@@ -1966,6 +1972,11 @@ void BackgroundCompileTask::Run(
                            end_position_, function_literal_id_);
   parser.UpdateStatistics(script_, &use_counts_, &total_preparse_skipped_);
 
+#else
+  info.pending_error_handler()->ReportMessageAt(
+      0, 0, MessageTemplate::kJavaScriptParserDisabled);
+#endif
+
   TRACE_EVENT0(TRACE_DISABLED_BY_DEFAULT("v8.compile"),
                "V8.CompileCodeBackground");
   RCS_SCOPE(isolate, RuntimeCallCounterIdForCompile(&info),
