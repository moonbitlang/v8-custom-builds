From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wee8 maintenance <noreply@moonbitlang.com>
Date: Mon, 26 Oct 2026 10:18:17 +0800
Subject: Adapt the pinned build tools to the supported runner environments

Upstream-Status: Local build compatibility
Maintenance: Drop each workaround when the pinned upstream handles its compiler, host architecture or Visual Studio version.
Tests: Native consumer matrix; Linux ARM64 system Clang and Windows toolchain discovery.

Adapt the native bootstrap to supported hosts:
- Normalize aarch64 to arm64 for GN/Ninja packages. Windows keeps x64 tools;
  Windows ARM64 remains outside the supported matrix.
- Download Linux sysroots only for Linux targets.
- Ask system Clang for compiler-rt instead of assuming Chromium's layout,
  then pass that path to the Chromium build patch.

diff --git a/build.rs b/build.rs
index 4aead47749ab16a58d96e477762cbdcf9421d098..19a215ad86c85e1067710125e71aa95161be421f 100644
--- a/build.rs
+++ b/build.rs
@@ -210,6 +210,19 @@ fn build_v8(is_asan: bool) {
     println!("clang_base_path (system): {}", clang_base_path.display());
     gn_args.push(format!("clang_base_path={:?}", clang_base_path));
     gn_args.push("treat_warnings_as_errors=false".to_string());
+    if target_os == "linux" {
+      // Distribution Clang packages do not use Chromium's compiler-rt layout.
+      let output = Command::new(clang_base_path.join("bin/clang"))
+        .arg(format!("--target={}", env::var("TARGET").unwrap()))
+        .args(["--rtlib=compiler-rt", "--print-libgcc-file-name"])
+        .output()
+        .expect("query Clang's builtins library");
+      assert!(output.status.success());
+      let library = String::from_utf8(output.stdout).unwrap();
+      let library = library.trim();
+      assert!(Path::new(library).is_file(), "missing compiler-rt: {library}");
+      gn_args.push(format!("clang_builtin_library={library:?}"));
+    }
   } else {
     println!("using Chromium's clang");
     let clang_base_path = clang_download();
@@ -241,8 +254,10 @@ fn build_v8(is_asan: bool) {
   if target_arch == "aarch64" {
     gn_args.push(r#"target_cpu="arm64""#.to_string());
     gn_args.push("use_sysroot=true".to_string());
-    maybe_install_sysroot("arm64");
-    maybe_install_sysroot("amd64");
+    if target_os == "linux" {
+      maybe_install_sysroot("arm64");
+      maybe_install_sysroot("amd64");
+    }
   }
   if target_arch == "arm" {
     gn_args.push(r#"target_cpu="arm""#.to_string());
diff --git a/tools/ninja_gn_binaries.py b/tools/ninja_gn_binaries.py
index 029be98ea68aa4732ffe320e1aa8869f24265168..98e6427ce63b7c0f3544a784c0ec7b47a29a5316 100755
--- a/tools/ninja_gn_binaries.py
+++ b/tools/ninja_gn_binaries.py
@@ -27,6 +27,11 @@ def get_platform():
     machine = platform.machine().lower()
     if machine == 'x86_64':
         machine = 'amd64'
+    elif machine == 'aarch64':
+        machine = 'arm64'
+    # The pinned Windows GN/Ninja packages are x64; Windows ARM64 can run them.
+    if system == 'windows':
+        machine = 'amd64'
 
     return f'{system}-{machine}'
 
