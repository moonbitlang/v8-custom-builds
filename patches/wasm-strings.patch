+bool IsBuiltinImport(const i::wasm::NativeModule* native_module,
+                     const i::wasm::WasmImport& import) {
+  if (import.kind == i::wasm::kExternalFunction) {
+    return i::wasm::IsCompileTimeImport(
+        native_module->module()->type_feedback.well_known_imports.get(
+            import.index));
