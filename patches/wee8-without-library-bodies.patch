Subject: Omit unsupported JS library builtin bodies in custom wee8

Enabled for custom wee8; ordinary V8 retains its original bodies.
Base: rusty_v8 v0.106.0, V8 12.9.202.13.

--- a/BUILD.gn
+++ b/BUILD.gn
@@ -51,7 +51,11 @@
 
 # Build the Wasm C API and its native regression probe with identical settings.
 group("wee8-build") {
-  deps = [ ":custom_wee8", ":wee8-runtime-check(//custom_wee8:custom_wee8)" ]
+  deps = [
+    ":custom_wee8",
+    ":wee8-runtime-check(//custom_wee8:custom_wee8)",
+    ":wee8-library-check(//custom_wee8:custom_wee8)",
+  ]
 }
 
 # Public entry point for the isolated native Wasm profile.
@@ -81,3 +85,16 @@
   ]
   include_dirs = [ "v8" ]
 }
+
+executable("wee8-library-check") {
+  sources = [ "wee8-library-check.cc" ]
+  deps = [
+    # This probe includes the retained probe with its entry point renamed.
+    ":wee8-runtime-check",
+    "//v8:wee8",
+    "//v8:v8_libplatform",
+    "//v8:v8_internal_headers",
+    "//v8:v8_abseil",
+  ]
+  configs += [ ":wee8_probe_config" ]
+}
