From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wee8 maintenance <noreply@moonbitlang.com>
Date: Mon, 26 Oct 2026 10:18:17 +0800
Subject: Adapt the pinned build tools to the supported runner environments

Upstream-Status: Local build compatibility
Maintenance: Drop each workaround when the pinned upstream handles its compiler, host architecture or Visual Studio version.
Tests: Native consumer matrix; Linux ARM64 system Clang and Windows toolchain discovery.

Use the compiler-rt path supplied by the native bootstrap for compiler_builtins;
other Clang libraries keep their upstream paths. Add Visual Studio 2026 discovery
(directory 18, runtime VC145) while retaining existing version overrides.
A Windows run validates only the Visual Studio version it actually selects.

diff --git a/config/clang/BUILD.gn b/config/clang/BUILD.gn
index fcca59b0f0bf4c019ea0dbca34f0c457af03d54b..e08c4176f4845dad528af22854d39f19ed92e416 100644
--- a/config/clang/BUILD.gn
+++ b/config/clang/BUILD.gn
@@ -163,7 +163,12 @@ group("llvm-symbolizer_data") {
 }
 
 template("clang_lib") {
-  if (!defined(invoker.libname)) {
+  if (target_name == "compiler_builtins" && clang_builtin_library != "") {
+    not_needed(invoker, "*")
+    config(target_name) {
+      libs = [ clang_builtin_library ]
+    }
+  } else if (!defined(invoker.libname)) {
     not_needed(invoker, "*")
     config(target_name) {
     }
diff --git a/config/clang/clang.gni b/config/clang/clang.gni
index 9928fc37b8b55232506a30f93d0474be4b0f9f4c..c5556b0d5071f2517c337abb565e4dcf32685716 100644
--- a/config/clang/clang.gni
+++ b/config/clang/clang.gni
@@ -32,6 +32,9 @@ declare_args() {
 
   clang_base_path = default_clang_base_path
 
+  # Optional builtins archive for distribution-provided Clang toolchains.
+  clang_builtin_library = ""
+
   # Specifies whether or not bitcode should be embedded during compilation.
   # This is used for creating a MLGO corpus from Chromium in the non-ThinLTO case.
   clang_embed_bitcode = false
