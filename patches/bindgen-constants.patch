Subject: Preserve typed-array constants when generating Rust bindings

Base: rusty_v8 v0.106.0 (e9f20a2493883b53cb58b19a2fe761358dd57996).

The pinned bindgen 0.69.4 can omit variables whose names are generated by
macro token concatenation when used with newer libclang. Native compilation
can succeed, but Rust then fails to find the v8__*Array__kMaxLength constants
in the generated src_binding.rs.

Spell out the eleven declarations in src/binding.hpp. Their names, types,
and values remain the same: each value still comes from the corresponding
V8 header constant. This changes binding generation, not the native ABI or
the Rust API. Keep this list aligned with EACH_TYPED_ARRAY in src/support.h
when updating the upstream pin; do not replace the values with literals.

Validation: regenerate src_binding.rs with the CI libclang and compile the
Rust crate, then run the standalone consumer against the packaged bindings
and archive. Applying the patch alone does not test binding generation.
Remove it once the upstream declarations or bindgen/libclang combination
generates all eleven constants without this workaround.

Upstream declaration:
https://github.com/denoland/rusty_v8/blob/v0.106.0/src/binding.hpp

diff --git a/src/binding.hpp b/src/binding.hpp
--- a/src/binding.hpp
+++ b/src/binding.hpp
@@ -24,10 +24,19 @@
 
 static size_t v8__TypedArray__kMaxByteLength = v8::TypedArray::kMaxByteLength;
 
-#define TYPED_ARRAY_MAX_LENGTH(name) \
-  static size_t v8__##name##__kMaxLength = v8::name::kMaxLength;
-EACH_TYPED_ARRAY(TYPED_ARRAY_MAX_LENGTH)
-#undef TYPED_ARRAY_MAX_LENGTH
+// Keep these declarations explicit: bindgen 0.69.4 with newer libclang can
+// omit variables whose names are produced by macro token concatenation.
+static size_t v8__Uint8Array__kMaxLength = v8::Uint8Array::kMaxLength;
+static size_t v8__Uint8ClampedArray__kMaxLength = v8::Uint8ClampedArray::kMaxLength;
+static size_t v8__Int8Array__kMaxLength = v8::Int8Array::kMaxLength;
+static size_t v8__Uint16Array__kMaxLength = v8::Uint16Array::kMaxLength;
+static size_t v8__Int16Array__kMaxLength = v8::Int16Array::kMaxLength;
+static size_t v8__Uint32Array__kMaxLength = v8::Uint32Array::kMaxLength;
+static size_t v8__Int32Array__kMaxLength = v8::Int32Array::kMaxLength;
+static size_t v8__Float32Array__kMaxLength = v8::Float32Array::kMaxLength;
+static size_t v8__Float64Array__kMaxLength = v8::Float64Array::kMaxLength;
+static size_t v8__BigUint64Array__kMaxLength = v8::BigUint64Array::kMaxLength;
+static size_t v8__BigInt64Array__kMaxLength = v8::BigInt64Array::kMaxLength;
 
 using v8__CFunction = v8::CFunction;
 using v8__CFunctionInfo = v8::CFunctionInfo;
