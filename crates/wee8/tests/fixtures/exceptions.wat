(module
  (import "exception" "tag" (tag $tag (param i32)))
  (import "exception" "other" (tag $other (param i32)))
  (import "exception" "throw" (func $throw))
  (export "tag" (tag $tag))
  (func (export "caught") (result i32)
    (block $caught (result i32)
      (try_table (catch $tag $caught) call $throw)
      i32.const -1))
  (func (export "wrong_tag")
    (block $caught (result i32)
      (try_table (catch $other $caught) call $throw)
      i32.const -1)
    drop)
  (func (export "catch_all")
    (block $caught (try_table (catch_all $caught) call $throw)))
  (func (export "guest_throw") i32.const 17 throw $tag)
  (func (export "rethrow")
    (block $caught (result exnref)
      (try_table (catch_all_ref $caught) call $throw)
      unreachable)
    throw_ref)
  (func (export "alive") (result i32) i32.const 7))
