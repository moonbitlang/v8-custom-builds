# Compile probes in the same scope as wee8 and mksnapshot. This group never
# pulls the ordinary V8 toolchain's archive into the build.
check_targets = [
  "wee8-runtime-check",
  "cpp-entry-contract",
  "runtime-entry-contract",
  "generated-builtin-contract",
  "generated-builtin-catalog",
  "runtime-catalog",
  "runtime-boundaries",
  "store-lifetimes",
]

group("checks") {
  deps = []
  foreach(name, check_targets) {
    deps += [ ":${name}" ]
  }
}

foreach(name, check_targets) {
  executable(name) {
    sources = [ "${name}.cc" ]
    deps = [
      "//v8:v8_abseil",
      "//v8:v8_internal_headers",
      "//v8:v8_libplatform",
      "//v8:wee8",
    ]
    configs += [ ":probe_config" ]
    include_dirs = [ "//custom_wee8/include" ]
  }
}

# Follow the upstream config wrapper for V8's private toolchain config, but
# keep normal executable CRT linkage instead of the Rust adapter's /Zl flag.
config("probe_config") {
  # Every probe links the static wee8 archive, including on Windows.
  defines = [ "LIBWASM_STATIC" ]
  configs = [
    "//v8:internal_config",
    "//v8:external_config",
    "//v8:toolchain",
    "//v8:features",
  ]
  include_dirs = [ "//v8" ]
}
