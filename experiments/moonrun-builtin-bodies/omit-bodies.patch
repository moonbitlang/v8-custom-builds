   // Create a scope for the handles in the builtins.
   HandleScope scope(isolate);
 
+  // Select bodies here, without changing the builtin tables, descriptors,
+  // registration, placeholders or bootstrap references. The normal TFJ builder
+  // still creates a distinct Code with the original builtin ID and argc.
+#if defined(V8_MOONRUN_OMIT_LIBRARY_BUILTIN_BODIES)
+#define CHECK_OMITTED_KIND(Name, Receiver, Method) \
+  CHECK_EQ(Builtins::KindOf(Builtin::k##Name), Builtins::TFJ);
+  MOONRUN_OMITTED_JS_BUILTINS(CHECK_OMITTED_KIND)
+#undef CHECK_OMITTED_KIND
+#endif
+  const auto select_js_body = [](Builtin builtin,
+                                 CodeAssemblerGenerator original) {
+#if defined(V8_MOONRUN_OMIT_LIBRARY_BUILTIN_BODIES)
+    switch (builtin) {
+#define OMITTED_CASE(Name, Receiver, Method) case Builtin::k##Name:
+      MOONRUN_OMITTED_JS_BUILTINS(OMITTED_CASE)
+#undef OMITTED_CASE
+        // Intentional unsupported-API trap, not an Illegal code alias or a
+        // fake return value. The owning builtin ID identifies the omitted API.
+        return +[](compiler::CodeAssemblerState* state) {
+          compiler::CodeAssembler(state).Unreachable();
+        };
+      default:
+        break;
+    }
+#endif
+    return original;
+  };
